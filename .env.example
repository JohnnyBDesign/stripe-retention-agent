# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Configuration
# RESEND_API_KEY is required for enrolling contacts in retention segments.
# The system automatically creates and manages segments named ret_* (e.g., ret_price, ret_bug).
RESEND_API_KEY=re_...

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/retention_agent

# Application
NODE_ENV=development
