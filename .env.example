# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Configuration
# RESEND_API_KEY is Signal's platform key for sending retention emails on behalf of customers.
# After HITL approval, Signal sends emails from our Resend domain with Reply-To set to founder.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Signal <noreply@yourdomain.com>

# Reply-To Configuration (legacy fallback)
# FOUNDER_REPLY_TO is legacy fallback for sending retention emails.
# In multi-tenant mode, each user sets their own Reply-To in settings.
# NEVER set this to the customer email - replies go to founder/team, not the subscriber.
FOUNDER_REPLY_TO=johnbreenbusiness@gmail.com

# Queue Security
# REQUIRED in production. Password for accessing the admin HITL queue.
# Queue fails closed if not set - unauthenticated requests return 401/503.
QUEUE_SECRET=your-secure-password-here

# Multi-tenant Authentication
# JWT_SECRET is used to sign authentication tokens
JWT_SECRET=your-random-jwt-secret-change-in-production

# Encryption
# ENCRYPTION_KEY is used to encrypt Stripe keys at rest (32 bytes recommended)
ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/retention_agent
