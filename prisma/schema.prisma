generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String?
  name              String?
  company           String?
  replyToEmail      String?
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  stripeConnections StripeConnection[]
  retentionCases    RetentionCase[]
  
  @@index([email])
}

model StripeConnection {
  id                   String   @id @default(cuid())
  userId               String
  encryptedKey         String
  keyLast4             String
  webhookEndpointId    String?
  webhookSecret        String?
  stripeAccountId      String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([stripeAccountId])
}

model StripeEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  type           String
  payload        Json
  processed      Boolean  @default(false)
  userId         String?
  createdAt      DateTime @default(now())
  
  @@index([stripeEventId])
  @@index([type])
  @@index([processed])
  @@index([userId])
}

model CustomerActivity {
  id                String   @id @default(cuid())
  customerId        String
  stripeCustomerId  String?
  lastActiveAt      DateTime?
  activationCompletedAt DateTime?
  events            Json?
  userId            String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  
  @@unique([customerId])
  @@index([customerId])
  @@index([stripeCustomerId])
  @@index([userId])
}

model RetentionCase {
  id                  String   @id @default(cuid())
  userId              String?
  customerId          String
  customerEmail       String
  subscriptionId      String?
  plan                String
  mrr                 Float
  tenureDays          Int
  reason              String
  confidence          Float
  evidence            Json
  recommendedSequence String?
  subjectDraft        String
  bodyDraft           String
  state               String   @default("pending")
  overrideReason      String?
  triggerType         String
  stripeEventIds      String[]
  slaDueAt            DateTime?
  snoozeUntil         DateTime?
  reviewedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  resendEnrollment    ResendEnrollment?
  
  @@index([userId])
  @@index([customerId])
  @@index([state])
  @@index([reason])
  @@index([createdAt])
  @@index([slaDueAt])
}

model ResendEnrollment {
  id               String   @id @default(cuid())
  caseId           String   @unique
  contactId        String?
  customerId       String
  tag              String
  tags             String[]
  triggerEventId   String
  enrolledAt       DateTime @default(now())
  
  case             RetentionCase @relation(fields: [caseId], references: [id])
  
  @@unique([customerId, tag, triggerEventId])
  @@index([caseId])
  @@index([triggerEventId])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  
  @@index([customerId])
  @@index([occurredAt])
}

model FoundingApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  mrrBand   String
  createdAt DateTime @default(now())
  
  @@index([email])
  @@index([createdAt])
}
